# On ignore les gros dossiers regenerables. Le code, les documents et les AGENTS.md
# sont versionnes. ATTENTION : ce depot contient les identifiants de la base du site —
# il ne doit JAMAIS partir sur un service en ligne.
node_modules/
_travail/_backups/
_travail/_prod_copie_*/
*.log

# --- Ajout du 18/11/2026 ---------------------------------------------------
# Les dossiers d'audit contiennent des RAPPORTS ET DES SCRIPTS, qu'on versionne.
# Mais on n'y met PAS les artefacts : apercus regenere par PHP, captures d'ecran,
# et surtout les LIENS vers assets/ et le profil temporaire de Chrome (des
# milliers de fichiers binaires qui n'ont rien a faire dans un depot).
_travail/_audit_*/apercu/_chrome_tmp/
_travail/_audit_*/apercu/sortie/
_travail/_audit_*/apercu/sortie_site/
_travail/_audit_*/apercu/captures/
_travail/_audit_*/_corpus_relecture/
_travail/_audit_*/phpstan/*.cache

# --- Ajout du 18/11/2026 : le fichier de configuration ne se versionne PAS ---
# Il porte l'hote, le nom de la base et le mot de passe. Ici c'est la config
# d'ESSAI (base locale, mot de passe vide), mais sur le serveur c'est celle de
# production. En le sortant du depot, on garantit qu'aucune version publiee ne
# pourra le contenir — quel que soit le jour où quelqu'un y mettra un secret.
# Le modele a recopier est `config.example.php`.
home/capi3439/zeusstack/motohall/includes/config.php
home/capi3439/zeusstack/motohall/includes/config.local.php

# Les jetons et cles, quels qu'ils soient.
.env
.env.*
*.pem
*.key

# --- 18/11/2026 : LES AUDITS NE SORTENT PAS DU POSTE ---
# Les dossiers _audit_* contiennent des rapports qui decrivent, fichier par ligne,
# les failles trouvees et comment les exploiter, et des instantanes complets du
# code (dont config.php). C'est un plan d'attaque, pas du code.
_travail/_audit_*/
