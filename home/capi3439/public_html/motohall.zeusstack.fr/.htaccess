# Aegis Sentinel - Error Routing
ErrorDocument 400 /motohall2a/error.php?code=400
ErrorDocument 401 /motohall2a/error.php?code=401
ErrorDocument 403 /motohall2a/error.php?code=403
ErrorDocument 404 /motohall2a/error.php?code=404
ErrorDocument 500 /motohall2a/error.php?code=500
ErrorDocument 502 /motohall2a/error.php?code=502
ErrorDocument 503 /motohall2a/error.php?code=503

# Basic Directory Protection
Options -Indexes
